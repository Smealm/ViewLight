<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ViewLight.ViewModels"
             xmlns:services="using:ViewLight.Services"
             x:Class="ViewLight.Views.LogsView"
             x:DataType="vm:MainWindowViewModel">

  <DockPanel>

    <!-- ================================================================ what to show
         Three boxes rather than one list, because the question is which of the three things are worth
         reading right now - all of them, or the one that is misbehaving. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
      <Button Content="Clear" Command="{Binding ClearLogsCommand}" />
      <TextBlock Classes="muted" Text="Show:" VerticalAlignment="Center" />
      <CheckBox Content="Launcher" IsChecked="{Binding ShowLauncherLog, Mode=TwoWay}" />
      <CheckBox Content="Server" IsChecked="{Binding ShowServerLog, Mode=TwoWay}" />
      <CheckBox Content="Patch server" IsChecked="{Binding ShowPatchServerLog, Mode=TwoWay}" />
      <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScrollLogs, Mode=TwoWay}" />
    </StackPanel>

    <!-- How much is here, how much is folded, and how much the boxes above are keeping out of sight. -->
    <TextBlock DockPanel.Dock="Bottom" Classes="muted"
               Text="{Binding LogSummary}" Margin="0,8,0,0" />

    <Border Classes="card" Padding="0">
      <!-- A document rather than a list: the whole log is one piece of monospace text per run of lines, so
           a drag across it copies the run, and art a process printed is not re-wrapped into nonsense. -->
      <ScrollViewer x:Name="LogScroll"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Log.Blocks}" Margin="14,10">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="services:LogBlock">
              <StackPanel Orientation="Vertical">
                <!-- A run of the same line arriving again, folded to one line. The number is the count, and
                     pressing it opens the run so the lines can be read and copied, or folds it back up. -->
                <Button Classes="logFold"
                        Content="{Binding FoldLine}"
                        IsVisible="{Binding HasFoldLine}"
                        Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}"
                        Click="OnFoldClick" />
                <SelectableTextBlock Classes="terminal"
                                     Text="{Binding Body}"
                                     IsVisible="{Binding HasBody}"
                                     Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

  </DockPanel>
</UserControl>
