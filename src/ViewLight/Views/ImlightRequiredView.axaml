<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ViewLight.ViewModels"
             x:Class="ViewLight.Views.ImlightRequiredView"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource ContentBackgroundBrush}">

  <ScrollViewer>
    <StackPanel MaxWidth="660" Spacing="16" Margin="40,44"
                HorizontalAlignment="Center" VerticalAlignment="Center">

      <TextBlock Text="ViewLight needs Imlight" Classes="heroTitle" HorizontalAlignment="Center" />

      <!-- Why, before what: the launcher refusing to start is worth an explanation, and both halves of it
           are things the user cannot see from the outside. -->
      <TextBlock Classes="muted" TextAlignment="Center"
                 Text="ViewLight is a launcher for Imlight — it installs it, configures it, runs it and plays it. It also keeps your profiles, playtime and badges in the RavenDB the server ships, so with no server there is nothing to start and nowhere to keep your progress." />

      <!-- ============================================ what is missing -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="cardTitle" Text="What is missing" />
          <TextBlock Classes="warning" Text="{Binding ImlightProblem}" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Check again" Command="{Binding CheckImlightAgainCommand}" />
            <Button Content="{Binding ImlightActionLabel}"
                    IsVisible="{Binding HasImlightAction}"
                    Command="{Binding OpenLinkCommand}"
                    CommandParameter="{Binding ImlightActionUrl}" />
          </StackPanel>

          <!-- The one gap whose fix is not obvious from the link on its own: a version's download page
               offers several downloads, and only one of them is the one the database wants. -->
          <TextBlock Classes="muted" Text="{Binding ImlightGuide}"
                     IsVisible="{Binding HasImlightGuide}" />
        </StackPanel>
      </Border>

      <!-- ============================================ where Imlight is -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="cardTitle" Text="Where Imlight is" />
          <TextBlock Classes="muted"
                     Text="The folder holding Imlight.Director.exe and Config\Imlight.ini. Pointing at one that is already there is enough — nothing here writes to it except an install." />

          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBox Text="{Binding ServerPath, Mode=TwoWay}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="Use recommended"
                    Command="{Binding UseRecommendedServerFolderCommand}" />
            <Button Grid.Column="2" Margin="8,0,0,0" Content="Browse…"
                    Command="{Binding BrowseServerFolderCommand}" />
          </Grid>

          <TextBlock Classes="status" Text="{Binding ServerFolderStatus}" />
        </StackPanel>
      </Border>

      <!-- ============================================ getting one -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="cardTitle" Text="Get Imlight" />

          <!-- Which builds to install. The choice is here as well as in Settings because it is the
               first screen a machine with no server sees, and the one channel that is not a download
               must not be reachable only after there is a server to change settings on. -->
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Build channel" />
            <StackPanel Orientation="Horizontal" Spacing="18" IsEnabled="{Binding !IsBusy}">
              <RadioButton GroupName="ServerChannelFirstRun" Content="Stable release"
                           IsChecked="{Binding IsStableChannel, Mode=TwoWay}" />
              <RadioButton GroupName="ServerChannelFirstRun" Content="Prerelease"
                           IsChecked="{Binding IsPrereleaseChannel, Mode=TwoWay}" />
              <RadioButton GroupName="ServerChannelFirstRun" Content="Bleeding edge"
                           IsChecked="{Binding IsBleedingEdgeChannel, Mode=TwoWay}" />
            </StackPanel>
            <TextBlock Classes="muted note" TextWrapping="Wrap" Text="{Binding ChannelNote}" />

            <!-- The branch, on the screen that has no server yet: a feature branch is exactly what
                 somebody choosing this channel on a fresh machine is after, and it must not need a
                 built server before it can be picked. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsBleedingEdge}"
                        IsEnabled="{Binding !IsBusy}">
              <TextBlock Classes="label" Text="Branch" />
              <ComboBox MinWidth="300" HorizontalAlignment="Left"
                        ItemsSource="{Binding EdgeBranches}"
                        SelectedItem="{Binding EdgeBranch, Mode=TwoWay}"
                        PlaceholderText="The repository's default branch" />
              <TextBlock Classes="muted note" TextWrapping="Wrap"
                         Text="{Binding EdgeBranchNote}" />
            </StackPanel>
          </StackPanel>

          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding InstallDescription}" />

          <TextBlock Classes="warning" TextWrapping="Wrap"
                     Text="{Binding BleedingEdgeWarning}"
                     IsVisible="{Binding IsBleedingEdge}" />

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="accent" Content="{Binding InstallImlightLabel}"
                    Command="{Binding InstallImlightCommand}" />
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding LatestReleaseText}" />
          </StackPanel>

          <TextBlock Classes="muted note" TextWrapping="Wrap"
                     Text="{Binding EdgeTypeDumpNote}"
                     IsVisible="{Binding IsBleedingEdge}" />

          <TextBlock Classes="error" Text="{Binding ReleaseCheckError}"
                     IsVisible="{Binding HasReleaseCheckError}" />
        </StackPanel>
      </Border>

      <!-- ============================================ downloading, while it runs -->
      <Border Classes="glass" IsVisible="{Binding IsBusy}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding InstallStage}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelInstallCommand}" />
          </Grid>
          <ProgressBar Value="{Binding InstallProgress}" Maximum="100" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
