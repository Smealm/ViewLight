<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ViewLight.ViewModels"
             xmlns:services="using:ViewLight.Services"
             x:Class="ViewLight.Views.SignInView"
             x:DataType="vm:MainWindowViewModel">

  <!-- ============================================================ signing in
       A full-window cover rather than another page, because nobody is signed in: every page behind it belongs
       to nobody, and a launcher left showing a profile after it was signed out would be showing a page that
       does not know whose it is. Fullscreen the way a console's account picker is - the accounts are the whole
       screen, and the one thing to do is pick one.

       Hidden altogether rather than merely faded out, so nothing on it can be reached by the keyboard while
       it is not on screen; the fade and the strip's own glide still make it arrive rather than appear. The
       state is the view model's, so the screen cannot be left half-shown. -->
  <Border Classes="signIn" Classes.shown="{Binding IsSignedOut}"
          IsVisible="{Binding IsSignedOut}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="56,34,56,26">

      <!-- ======================================================== who is there -->
      <StackPanel Spacing="6">
        <TextBlock Text="ViewLight" FontSize="12" FontWeight="Bold" Classes="accent" />
        <TextBlock Text="Who's playing?" FontSize="34" FontWeight="Bold" />
        <TextBlock Classes="muted" FontSize="13" Text="{Binding SignInSubtitle}" />
      </StackPanel>

      <!-- ======================================================== the accounts, in a row
           Horizontal because the accounts are a row of people rather than a list of settings: scrolling
           sideways is what makes it read as a shelf to walk along. The arrows move a page at a time, and the
           strip animates its way in. -->
      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

        <Button Grid.Column="0" Classes="signInArrow" Content="‹" Click="OnScrollLeft"
                VerticalAlignment="Center" IsVisible="{Binding HasAccountCards}"
                ToolTip.Tip="The accounts to the left" />

        <ScrollViewer Grid.Column="1" x:Name="AccountStrip" Classes="accountStrip"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding AccountCards}" Margin="8,18">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="services:AccountCard">
                <Button Classes="accountCard" Click="OnAccountCardClicked"
                        Tag="{Binding AccountId}"
                        ToolTip.Tip="{Binding WizardsCaption}">
                  <Border Classes="accountTile" Width="252">

                    <Grid RowDefinitions="Auto,*">

                      <!-- The banner, with the picture sitting on its bottom edge. A picture if one was
                           chosen, and otherwise the card's own surface, so the header does not collapse into a
                           gap. The gradient is what the picture fades into, so the name is read against the
                           theme rather than against whatever the banner happens to be. -->
                      <Panel Height="104">
                        <Border CornerRadius="11,11,0,0"
                                Background="{DynamicResource SidebarBackgroundBrush}" />
                        <Border CornerRadius="11,11,0,0" IsVisible="{Binding HasBanner}">
                          <Border.Background>
                            <ImageBrush Source="{Binding Banner}" Stretch="UniformToFill" />
                          </Border.Background>
                        </Border>
                        <Border CornerRadius="11,11,0,0">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                              <GradientStop Offset="0" Color="#00000000" />
                              <GradientStop Offset="1" Color="#AA000000" />
                            </LinearGradientBrush>
                          </Border.Background>
                        </Border>

                        <Panel Width="76" Height="76" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Margin="0,0,0,-38">
                          <Ellipse Width="76" Height="76" IsVisible="{Binding HasAvatar}"
                                   Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="3">
                            <Ellipse.Fill>
                              <ImageBrush Source="{Binding Avatar}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                          </Ellipse>

                          <Ellipse Width="76" Height="76" Fill="{DynamicResource AccentBrush}"
                                   IsVisible="{Binding !HasAvatar}" />
                          <TextBlock Text="{Binding Initials}" IsVisible="{Binding !HasAvatar}"
                                     FontSize="26" FontWeight="Bold" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                      </Panel>

                      <StackPanel Grid.Row="1" Margin="18,48,18,16" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Username}" Classes="muted" FontSize="11"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Spacing="7"
                                    HorizontalAlignment="Center" Margin="0,8,0,0">
                          <TextBlock Text="Gamerscore" Classes="muted" FontSize="10"
                                     VerticalAlignment="Center" />
                          <TextBlock Text="{Binding ScoreText}" FontSize="18" FontWeight="Bold" />
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource CardBorderBrush}"
                                Margin="0,10,0,8" />

                        <TextBlock Text="{Binding WizardsCaption}" Classes="muted" FontSize="10"
                                   HorizontalAlignment="Center" />

                        <!-- The wizards, one line each: the school's logo, the name, and the level. A school
                             whose logo has not arrived is drawn by its level rather than by a made-up symbol,
                             which is the same rule the profile's own shelf follows. -->
                        <ItemsControl ItemsSource="{Binding Wizards}" Margin="0,4,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:AccountWizardLine">
                              <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="7" Margin="0,2">
                                <Image Source="{Binding SchoolIcon}" Width="16" Height="16"
                                       Stretch="Uniform" IsVisible="{Binding HasSchoolIcon}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="11"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding LevelBadgeText}"
                                           Classes="muted" FontSize="11" VerticalAlignment="Center" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding MoreWizardsText}" Classes="muted" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"
                                   IsVisible="{Binding HasMoreWizards}" />
                      </StackPanel>

                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Button Grid.Column="2" Classes="signInArrow" Content="›" Click="OnScrollRight"
                VerticalAlignment="Center" IsVisible="{Binding HasAccountCards}"
                ToolTip.Tip="The accounts to the right" />
      </Grid>

      <!-- ======================================================== the way out
           Picking a profile is the way in; this is only for a launcher whose server has stopped offering any
           of them while the screen was up, so that being signed out cannot become being stuck. -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Classes="muted note" FontSize="11" TextWrapping="Wrap"
                   Text="These are the profiles this machine has read from your server. Choosing one signs ViewLight, and so Play, in as that account; nothing about a profile leaves this machine." />
        <Button Grid.Column="1" Content="Back to the launcher"
                Command="{Binding CancelSignInCommand}" />
      </Grid>

    </Grid>
  </Border>
</UserControl>
