<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ViewLight.ViewModels"
             xmlns:models="using:ViewLight.Models"
             x:Class="ViewLight.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel">

  <ScrollViewer>
    <StackPanel Spacing="16">

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Content="Apply recommended settings" Command="{Binding ApplyStarterPresetCommand}" />
        <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" />
        <Button Content="Reload from disk" Command="{Binding ReloadSettingsCommand}" />
      </StackPanel>

      <TextBlock Classes="muted note"
                 Text="Everything below is written into Config/Imlight.ini in your server folder. ViewLight only changes the values you can see; the rest of the file, comments and all, is left alone. The values are grouped into pages: pick one and the cards that belong to it are the ones you see." />

      <!-- ==================================================== the pages
           Settings is grouped by what the values belong to, and the group you are on is the page you are on.
           A group is not hidden away behind a menu: every page is one click from every other, and the group
           you are looking for says which page it is on rather than being found by scrolling past the rest. -->
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="nav" Classes.selected="{Binding IsServerSettings}" Content="Server"
                  Command="{Binding OpenSettingsTabCommand}" CommandParameter="Server" />
          <Button Classes="nav" Classes.selected="{Binding IsClientSettings}" Content="Client"
                  Command="{Binding OpenSettingsTabCommand}" CommandParameter="Client" />
          <Button Classes="nav" Classes.selected="{Binding IsLauncherSettings}" Content="ViewLight"
                  Command="{Binding OpenSettingsTabCommand}" CommandParameter="Launcher" />
          <Button Classes="nav" Classes.selected="{Binding IsDataSettings}" Content="Data"
                  Command="{Binding OpenSettingsTabCommand}" CommandParameter="Data" />
        </StackPanel>

        <!-- The second level, drawn only where there is one: the server is the server's own settings and the
             patch server's, and the client is where the game is and what a new character starts with.
             It sits in a well of its own, indented and smaller, and it starts with the name of the page it
             hangs off - because a row of buttons directly under another row of buttons is read as more
             pages, and these are not pages: they are the headings of the one that is open. -->
        <StackPanel Spacing="6" Margin="16,0,0,0" IsVisible="{Binding HasSettingsSubTabs}">
          <Border Classes="subnav" IsVisible="{Binding IsServerSettings}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="subnavCaption" Text="Server ›" />
              <Button Classes="subnav" Classes.selected="{Binding IsImlightSettings}" Content="ImLight"
                      Command="{Binding OpenServerSettingsTabCommand}" CommandParameter="Imlight" />
              <Button Classes="subnav" Classes.selected="{Binding IsAuroriumSettings}"
                      Content="Aurorium (patch server)"
                      Command="{Binding OpenServerSettingsTabCommand}" CommandParameter="Aurorium" />
            </StackPanel>
          </Border>

          <Border Classes="subnav" IsVisible="{Binding IsClientSettings}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="subnavCaption" Text="Client ›" />
              <Button Classes="subnav" Classes.selected="{Binding IsGameFolderSettings}" Content="Game folder"
                      Command="{Binding OpenClientSettingsTabCommand}" CommandParameter="GameFolder" />
              <Button Classes="subnav" Classes.selected="{Binding IsCharacterSettings}" Content="New characters"
                      Command="{Binding OpenClientSettingsTabCommand}" CommandParameter="Characters" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>

      <!-- ==================================================== the game folder -->
      <Border Classes="card" IsVisible="{Binding IsGameFolderSettings}">
        <StackPanel Spacing="12">
          <TextBlock Classes="cardTitle" Text="Game folder" />

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Where Wizard101 is installed" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Text="{Binding ClientPath, Mode=TwoWay}"
                       Watermark="C:\Program Files (x86)\Steam\steamapps\common\Wizard101" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="Detect"
                      Command="{Binding DetectGameFolderCommand}" />
              <Button Grid.Column="2" Margin="8,0,0,0" Content="Browse…"
                      Command="{Binding BrowseClientFolderCommand}" />
            </Grid>
            <TextBlock Classes="muted note"
                       Text="The folder holding bin\ and Data\ - not the bin folder itself. The game is started from here, and the client's own build is read from here." />
            <TextBlock Classes="status" Text="{Binding GameFolderStatus}" />
            <TextBlock Classes="muted" Text="{Binding RootWadStatus}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ==================================================== the server
           Everything to do with the Imlight server itself: where it lives, which build it is, keeping
           it current, and running it by hand. Home does the everyday version of this with Play, so this
           is where you come when you want the server on its own. -->
      <Border Classes="card" IsVisible="{Binding IsImlightSettings}">
        <StackPanel Spacing="14">
          <TextBlock Classes="cardTitle" Text="ImLight Settings" />

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Server folder" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Text="{Binding ServerPath, Mode=TwoWay}" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="Use recommended"
                      Command="{Binding UseRecommendedServerFolderCommand}" />
              <Button Grid.Column="2" Margin="8,0,0,0" Content="Browse…"
                      Command="{Binding BrowseServerFolderCommand}" />
            </Grid>
            <TextBlock Classes="status" Text="{Binding ServerFolderStatus}" />
          </StackPanel>

          <!-- Which builds the launcher installs. The two published channels are one GitHub lookup
               apart; the third is not a build at all, which is why it carries a warning rather than a
               tag and why the note underneath changes with the choice. -->
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Build channel" />
            <StackPanel Orientation="Horizontal" Spacing="18" IsEnabled="{Binding !IsBusy}">
              <RadioButton GroupName="ServerChannelSettings" Content="Stable release"
                           IsChecked="{Binding IsStableChannel, Mode=TwoWay}" />
              <RadioButton GroupName="ServerChannelSettings" Content="Prerelease"
                           IsChecked="{Binding IsPrereleaseChannel, Mode=TwoWay}" />
              <RadioButton GroupName="ServerChannelSettings" Content="Bleeding edge"
                           IsChecked="{Binding IsBleedingEdgeChannel, Mode=TwoWay}" />
            </StackPanel>
            <TextBlock Classes="muted note" TextWrapping="Wrap" Text="{Binding ChannelNote}" />
            <TextBlock Classes="warning" TextWrapping="Wrap"
                       Text="{Binding BleedingEdgeWarning}"
                       IsVisible="{Binding IsBleedingEdge}" />
            <!-- Which branch, for the one channel that has branches to choose between. The list is
                 GitHub's and arrives with the source check; empty means the repository's own default, so
                 the box never has to be filled in before there is a server to build. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsBleedingEdge}"
                        IsEnabled="{Binding !IsBusy}">
              <TextBlock Classes="label" Text="Branch" />
              <ComboBox MinWidth="300" HorizontalAlignment="Left"
                        ItemsSource="{Binding EdgeBranches}"
                        SelectedItem="{Binding EdgeBranch, Mode=TwoWay}"
                        PlaceholderText="The repository's default branch" />
              <TextBlock Classes="muted note" TextWrapping="Wrap"
                         Text="{Binding EdgeBranchNote}" />
            </StackPanel>

            <TextBlock Classes="muted note" TextWrapping="Wrap"
                       Text="{Binding EdgeTypeDumpNote}"
                       IsVisible="{Binding IsBleedingEdge}" />
          </StackPanel>

          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Classes="label" Text="Server build" />
            <TextBlock Grid.Column="1" Classes="value" Text="{Binding ServerBuildText}" />

            <TextBlock Grid.Row="1" Classes="label" Text="Client build" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding ClientBuildText}" />

            <TextBlock Grid.Row="2" Classes="label" Text="Installed" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="value"
                       Text="{Binding InstalledReleaseText}" />

            <TextBlock Grid.Row="3" Classes="label" Text="Available build" />
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="value"
                       Text="{Binding LatestReleaseText}" />
          </Grid>

          <TextBlock Classes="muted" Text="{Binding ClientBuildMissingHint}"
                     IsVisible="{Binding !HasClientBuild}" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" />
            <Button Classes="accent" Content="{Binding InstallButtonLabel}"
                    Command="{Binding InstallOrUpdateCommand}" />
          </StackPanel>

          <Border Classes="glass" IsVisible="{Binding IsBusy}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding InstallStage}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelInstallCommand}" />
              </Grid>
              <ProgressBar Value="{Binding InstallProgress}" Maximum="100" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Run the server yourself" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Start the server" Command="{Binding StartServerCommand}" />
              <Button Content="Stop the server" Command="{Binding StopServerCommand}" />
              <Button Content="Start Wizard101" Command="{Binding LaunchClientCommand}" />
              <Button Content="Open the log" Command="{Binding NavigateCommand}"
                      CommandParameter="Logs" />
            </StackPanel>
            <TextBlock Classes="muted note"
                       Text="Play on Home does all of this for you. These are here for running the server without the game, or starting the game against a server that is already up." />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="What Wizard101 is started with" />
            <TextBlock Classes="value" Text="{Binding ClientLaunchArguments}" />
          </StackPanel>

          <TextBlock Text="{Binding ClientBuildMismatch}" IsVisible="{Binding HasClientBuildMismatch}"
                     Classes.warning="{Binding EnforceRevision}"
                     Classes.muted="{Binding !EnforceRevision}" />
          <TextBlock Classes="error" Text="{Binding ReleaseCheckError}"
                     IsVisible="{Binding HasReleaseCheckError}" />
        </StackPanel>
      </Border>

      <!-- ==================================================== the patch server
           Not optional - Imlight loads Root.wad and the world data from a patch server, so every session
           has one - and the only real question is whose. Aurorium is the Revive101 project's file server:
           installed here, started before the server and pointed at from Imlight's config, the whole thing
           runs on this machine. The remote branch is an address and nothing else, because that is all the
           launcher has to say about somebody else's server. -->
      <Border Classes="card" IsVisible="{Binding IsAuroriumSettings}">
        <StackPanel Spacing="12">
          <TextBlock Classes="cardTitle" Text="Aurorium Settings" />

          <TextBlock Classes="muted note" TextWrapping="Wrap"
                     Text="Imlight asks a patch server for Root.wad and the world data, so a session always has one; the only question is whose. One here makes the whole thing local - Aurorium is the Revive101 project's own file server - while a remote one is reached over the network, the public instance being the community's machine. Downloading Aurorium takes a moment (about 9 MB); its first start then fetches the game's files from Wizard101's own patch server - 3,825 files, about 18 GB - or it can be handed them by a copy of the game on this machine, which takes minutes." />

          <!-- The one question, and it is not "use a patch server or not": Imlight cannot boot without one,
               so what is being chosen is whose. The two options are the same setting from both sides, and
               everything below follows from the answer. -->
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Use patch server" />
            <RadioButton GroupName="PatchServerSource" Content="Run one on this machine"
                         IsChecked="{Binding UseLocalPatchServer, Mode=TwoWay}" />
            <RadioButton GroupName="PatchServerSource" Content="Use a remote patch server"
                         IsChecked="{Binding UsesRemotePatchServer, Mode=TwoWay}" />
          </StackPanel>

          <!-- Remote: the address Imlight keeps, which the launcher does not touch. Play leaves it exactly as
               it is, so the public instance and somebody else's Aurorium are both reached by being left alone
               rather than by the launcher rewriting them. -->
          <StackPanel Spacing="4" IsVisible="{Binding UsesRemotePatchServer}">
            <TextBlock Classes="label" Text="Patch server address (PatchServerInternalUrl)" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding PatchServerUrl, Mode=TwoWay}"
                       Watermark="https://patcher.phill030.de" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="Use the public one"
                      Command="{Binding UsePublicPatchServerCommand}" />
            </Grid>
            <TextBlock Classes="muted note" TextWrapping="Wrap"
                       Text="Imlight downloads Root.wad from a patch server, so a server that is not answering stops the whole thing booting. The public address the Revive101 team runs is the default. Nothing here is written by Play: the address in the box is the one Imlight keeps." />
          </StackPanel>

          <!-- This machine's: the folder, the port, how the launcher runs it, and what it does with a patch
               server that holds nothing yet. -->
          <StackPanel Spacing="12" IsVisible="{Binding UseLocalPatchServer}">
            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !PatchServerInstalled}"
                       Text="There is no patch server here yet. Imlight keeps whatever address its own config has - the public one, unless it has been changed - so a session still runs; download Aurorium below and Play starts using it." />

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Patch server folder" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Text="{Binding PatchServerPath, Mode=TwoWay}" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="Use recommended"
                      Command="{Binding UseRecommendedPatchServerFolderCommand}" />
              <Button Grid.Column="2" Margin="8,0,0,0" Content="Browse…"
                      Command="{Binding BrowsePatchServerFolderCommand}" />
            </Grid>
            <TextBlock Classes="status" Text="{Binding PatchFolderStatus}" />
          </StackPanel>

          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Classes="label" Text="Installed" />
            <TextBlock Grid.Column="1" Classes="value" Text="{Binding PatchInstalledText}" />

            <TextBlock Grid.Row="1" Classes="label" Text="Newest release" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value"
                       Text="{Binding LatestPatchReleaseText}" />

            <TextBlock Grid.Row="2" Classes="label" Text="State" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="value"
                       Text="{Binding PatchServerRowState}" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Check for updates" Command="{Binding CheckForPatchServerUpdatesCommand}" />
            <Button Classes="accent" Content="Download the patch server"
                    Command="{Binding DownloadPatchServerCommand}" />
            <Button Content="Start" Command="{Binding StartPatchServerCommand}" />
            <Button Content="Stop" Command="{Binding StopPatchServerCommand}" />
          </StackPanel>

          <Border Classes="glass" IsVisible="{Binding IsPatchBusy}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding PatchInstallStage}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelPatchInstallCommand}" />
              </Grid>
              <ProgressBar Value="{Binding PatchInstallProgress}" Maximum="100" />
            </StackPanel>
          </Border>

          <!-- What it has fetched, while it is fetching it. The patch server's own row says what the
               process is doing; this says what the process is doing it for, which is the one thing the row
               cannot: Aurorium fetches a revision of thousands of files, and how far along that is decides
               whether a session will find its files here or fall back to Imlight's own cache. -->
          <StackPanel Spacing="6" IsVisible="{Binding HasFetchStatus}">
            <TextBlock Classes="status" TextWrapping="Wrap" Text="{Binding FetchStatus}" />
            <ProgressBar Value="{Binding FetchProgress}" Maximum="100" Height="4" />
          </StackPanel>

          <TextBlock Classes="error" Text="{Binding PatchCheckError}"
                     IsVisible="{Binding HasPatchCheckError}" />

          <Grid ColumnDefinitions="*,16,*">
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="Port it listens on" />
              <TextBox Text="{Binding PatchServerPort, Mode=TwoWay}" />
              <TextBlock Classes="muted note"
                         Text="Written into the patch server's own config.toml the next time it starts, along with the short retry interval and the download count its first fetch needs to finish." />
              <TextBlock Classes="error" TextWrapping="Wrap"
                         Text="{Binding PatchServerPortClashWarning}"
                         IsVisible="{Binding PatchServerPortClashes}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Classes="label" Text="On this machine" />
              <TextBlock Classes="value" Text="{Binding LocalPatchServerUrl}" />
              <Button HorizontalAlignment="Left" Content="Use this patch server"
                      Command="{Binding UseThisMachinesPatchServerCommand}" />
            </StackPanel>
          </Grid>

          <!-- Filling the revision in from a copy of the game on this machine. It is the same revision
               Wizard101's own patch server is serving, and a Steam install holds exactly that revision,
               so the files copied in are the files that would have been downloaded. -->
          <Border Classes="glass" IsVisible="{Binding PatchServerInstalled}">
            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="Filling it in from a copy of the game" />

              <TextBlock Classes="muted note" TextWrapping="Wrap"
                         Text="The patch server fetches a revision whole, and it fetches only what it is missing: it never looks again at a file it already has. So a machine that already holds the game's files can hand them to it instead of waiting for the download - which matters most for the files that are too large to arrive at all, since Aurorium gives up on a download that runs past its own two-minute limit.\n\nThis is a handout and not a second opinion about how the patch server should work, so it is exact by construction: the revision filled in is the one your server asks for, the copy it is filled from has to be that same revision, and not one file of it may be at a different length - because a file of the right name at the wrong size is another build's file, and the patch server never checks one it already has. Files the revision wants that this install does not have are left for the patch server to fetch. If any of that does not hold, nothing is copied and the line below says which condition failed." />

              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="Copy from" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBox Text="{Binding PreloadSourcePath, Mode=TwoWay}" Watermark="Found automatically" />
                  <Button Grid.Column="1" Margin="8,0,0,0" Content="Find it"
                          Command="{Binding FindPreloadSourceCommand}" />
                  <Button Grid.Column="2" Margin="8,0,0,0" Content="Browse…"
                          Command="{Binding BrowsePreloadSourceCommand}" />
                </Grid>
                <TextBlock Classes="status" TextWrapping="Wrap" Text="{Binding PreloadSourceInUse}" />
              </StackPanel>

              <TextBlock Classes="status" TextWrapping="Wrap" Text="{Binding PreloadStatus}"
                         IsVisible="{Binding HasPreloadStatus}" />

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="Copy the game's files in"
                        Command="{Binding PreloadPatchServerCacheCommand}" />
                <Button Content="Stop" Command="{Binding CancelPreloadCommand}" />
              </StackPanel>

              <StackPanel Spacing="10" IsVisible="{Binding IsPreloading}">
                <TextBlock Text="{Binding PreloadStage}" VerticalAlignment="Center" />
                <ProgressBar Value="{Binding PreloadProgress}" Maximum="100" />
              </StackPanel>
            </StackPanel>
          </Border>

          <CheckBox Content="Start it with the server, and stop it with the server"
                    IsChecked="{Binding PatchServerManaged, Mode=TwoWay}" />

          <TextBlock Classes="muted note" TextWrapping="Wrap"
                     Text="With this on, Play starts the patch server first, then the server, then Wizard101, and Imlight is given this machine's address so it loads its files from here. Both go down together when the server stops - unless the patch server is still fetching its files, when it is left running, because stopping it would stop the download. Turn this off to start and stop Aurorium yourself and be left alone." />

          <TextBlock Classes="muted note" TextWrapping="Wrap"
                     Text="Play does not copy anything into the patch server. Downloading is the patch server's own job, done its own way - it writes the revision's file list, fetches what that list names, and skips whatever it already has - and the launcher's part is to watch that and say how far along it is, so a session started before the revision has arrived says so in a line rather than sending the client off to find out. Copying the game's files in is a button rather than something Play does on the way past: it is the same files, it takes minutes rather than hours, and it is the only route there is for the files Aurorium's own two-minute download limit means it can never finish." />

          <!-- The two arrangements, stated from the side that is on, because they are not a feature and its
               absence: one makes the patch server keep the revision the server wants, the other makes the
               server accept whatever the patch server holds. The first is the default because it is the one
               that cannot invent anything. -->
          <CheckBox Content="Sync the patch server's revision with the server's accepted client revision"
                    IsChecked="{Binding PatchServerRevisionSynced, Mode=TwoWay}" />

          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="{Binding PatchServerRevisionModeText}"
                     IsVisible="{Binding PatchServerRevisionSynced}" />

          <TextBlock Classes="warning" TextWrapping="Wrap"
                     Text="{Binding PatchServerRevisionFallbackWarningText}"
                     IsVisible="{Binding !PatchServerRevisionSynced}" />

          <!-- ==================================================== the revisions on disk
               What the patch server has fetched, and who decides what stays. Automatic is the recommendation,
               and choosing it is the permission it needs; manual is the same cleanup with a person in the
               middle of it. -->
          <Border Classes="glass">
            <StackPanel Spacing="12">
              <TextBlock Classes="label" Text="The revisions it has fetched" />

              <TextBlock Classes="muted note" TextWrapping="Wrap"
                         Text="{Binding PatchServerCleanupRecommendationText}" />

              <StackPanel Spacing="4">
                <RadioButton GroupName="PatchServerCleanup"
                             Content="Clean up automatically (recommended)"
                             IsChecked="{Binding CleansUpRevisionsAutomatically, Mode=TwoWay}" />
                <RadioButton GroupName="PatchServerCleanup"
                             Content="Manage them myself"
                             IsChecked="{Binding ManagesRevisionsByHand, Mode=TwoWay}" />
              </StackPanel>

              <TextBlock Classes="status" TextWrapping="Wrap"
                         Text="{Binding PatchServerRevisionsStatus}"
                         IsVisible="{Binding HasPatchServerRevisionsStatus}" />

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Look again" Command="{Binding RefreshPatchServerRevisionsCommand}" />
                <Button Classes="accent" Content="Clean up unused revisions now"
                        Command="{Binding CleanUpUnusedPatchServerRevisionsCommand}"
                        IsVisible="{Binding CleansUpRevisionsAutomatically}" />
                <Button Classes="accent" Content="Delete the unticked ones"
                        Command="{Binding DeleteUnkeptRevisionsCommand}"
                        IsVisible="{Binding ManagesRevisionsByHand}" />
              </StackPanel>

              <!-- The list itself. Ticked means keep: the two revisions in use start ticked, everything else
                   starts unticked, so the list opens on the answer automatic mode reaches by itself. Each row
                   can also be asked for, which is how the one thing the launcher cannot do - fetch an older
                   revision - gets said rather than silently not happening. -->
              <Border Classes="list" IsVisible="{Binding HasPatchServerRevisions}">
                <ItemsControl ItemsSource="{Binding PatchServerRevisions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PatchServerRevisionRow">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,4">
                        <CheckBox Grid.Column="0" IsChecked="{Binding Keep, Mode=TwoWay}"
                                  IsEnabled="{Binding CanBeDeleted}" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding Name}" FontFamily="Consolas, monospace" FontSize="12" />
                          <TextBlock Classes="muted" FontSize="11"
                                     Text="{Binding RoleText}" />
                          <TextBlock Classes="muted" FontSize="11"
                                     Text="{Binding FilesText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                          <TextBlock Classes="value" Text="{Binding SizeText}" VerticalAlignment="Center" />
                          <Button Content="Download" Command="{Binding RequestDownloadCommand}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="{Binding PatchServerRevisionsEmptyText}"
                         IsVisible="{Binding !HasPatchServerRevisions}" />

              <TextBlock Classes="muted note" TextWrapping="Wrap"
                         Text="Removing a revision deletes its folder under the patch server's own data directory. Nothing that is being downloaded, nothing your server asks for, and nothing your game is can be removed while automatic cleanup is doing it - the manual list refuses only a revision the patch server is writing into, because the rest of it is your decision." />
            </StackPanel>
          </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ==================================================== administrator -->
      <Border Classes="card" IsVisible="{Binding IsImlightSettings}">
        <StackPanel Spacing="10">
          <TextBlock Classes="cardTitle" Text="Administrator account" />
          <TextBlock Classes="muted"
                     Text="Imlight creates this account on boot. Do not leave the stock values in place." />
          <TextBlock Classes="muted note" TextWrapping="Wrap"
                     Text="Imlight only ever creates this account - a password changed here after the first boot is not applied to it by the server - so ViewLight puts this password on the account in the player database itself, and says so below when it does." />

          <Grid ColumnDefinitions="*,16,*">
            <StackPanel>
              <TextBlock Classes="label" Text="Username (AdminAccountUsername)" />
              <TextBox Text="{Binding AdminUsername, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="Password (AdminAccountPassword)" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding AdminPassword, Mode=TwoWay}" />
                <Button Grid.Column="1" Margin="8,0,0,0" Content="Generate"
                        Command="{Binding GenerateAdminPasswordCommand}" />
              </Grid>
            </StackPanel>
          </Grid>

          <TextBlock Classes="status" Text="{Binding AdminPasswordNotice}"
                     IsVisible="{Binding HasAdminPasswordNotice}" />
        </StackPanel>
      </Border>

      <!-- ==================================================== making an account
           Instructions rather than a form, and this is the one place in the launcher where that is a
           deliberate removal. Writing an account document into Imlight's own player database worked, and
           it was the launcher authoring the server's storage: an overstep that the server itself has no
           need for, because it makes accounts its own way - .account create, typed by the admin account
           inside the game. Nothing else about accounts changed: the list, the picker and the profile are
           all reads of a database the server owns. -->
      <Border Classes="card" IsVisible="{Binding IsImlightSettings}">
        <StackPanel Spacing="12">

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="cardTitle" Text="Making another account" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="muted" Text="Made by the server, in the game"
                       VerticalAlignment="Center" />
          </Grid>

          <TextBlock Classes="muted note" TextWrapping="Wrap" Text="{Binding CreateAccountSummary}" />

          <TextBlock Classes="muted note" TextWrapping="Wrap"
                     Text="Nothing here writes into the server's database, so an account is made the way the server expects: it owns its own storage, and the launcher only ever reads it." />

        </StackPanel>
      </Border>

      <!-- ==================================================== new characters -->
      <Border Classes="card" IsVisible="{Binding IsCharacterSettings}">
        <StackPanel Spacing="12">
          <TextBlock Classes="cardTitle" Text="New characters" />
          <TextBlock Classes="muted note"
                     Text="What a brand new character starts with. The starter item list is set further down." />

          <CheckBox Content="Skip the tutorial (TutorialDisabled)"
                    IsChecked="{Binding TutorialDisabled, Mode=TwoWay}" />

          <TextBlock Classes="muted note" TextWrapping="Wrap"
                     Text="A new character drops into the starting zone instead of the tutorial. What the tutorial would have given the character is not given, so read the warning below before leaving this on." />

          <!-- Skipping the tutorial is three separate omissions in the game, none of which it mentions:
               the school's first spell, the equipped starter kit, and the tutorial's own items - which can
               arrive twice instead. All three are fixable in the game, so the fix is the warning. -->
          <TextBlock Classes="warning" TextWrapping="Wrap" IsVisible="{Binding TutorialDisabled}"
                     Text="The tutorial is off. New characters are not granted their school's first spell, are not equipped with the starter items, and can be granted tutorial items twice. Fix those in the game: walk to Ravenwood, learn your school's spell from the trainer, then equip the starter items from your inventory." />

          <Grid ColumnDefinitions="*,16,*">
            <StackPanel>
              <TextBlock Classes="label" Text="Starting level (StartingLevel)" />
              <TextBox Text="{Binding StartingLevel, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="Starting gold (BaseGoldPouch)" />
              <TextBox Text="{Binding BaseGoldPouch, Mode=TwoWay}" />
            </StackPanel>
          </Grid>

          <StackPanel>
            <TextBlock Classes="label" Text="Starting zone (StartingZone)" />
            <TextBox Text="{Binding StartingZone, Mode=TwoWay}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ==================================================== starter items -->
      <Border Classes="card" IsVisible="{Binding IsCharacterSettings}">
        <StackPanel Spacing="12">
          <TextBlock Classes="cardTitle" Text="Starter items" />
          <TextBlock Classes="muted note"
                     Text="These are the items a new character ends up holding, granted in the tutorial or on the first login when the tutorial is skipped." />

          <TextBlock Classes="warning" Text="{Binding StarterKitRequirement}" />

          <StackPanel>
            <TextBlock Classes="label" Text="Items granted (DefaultItems)" />
            <TextBox Text="{Binding DefaultItemsText, Mode=TwoWay}" />
          </StackPanel>

          <TextBlock Classes="error" Text="{Binding StarterKitError}"
                     IsVisible="{Binding HasStarterKitError}" />

          <Grid ColumnDefinitions="*,Auto,*" Height="270">

            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="label" Text="Available items" />
              <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="0,0,0,4"
                         Text="{Binding CatalogCountText}" />
              <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                       Text="{Binding ItemSearch, Mode=TwoWay}"
                       Watermark="Search by name, category or ID…" />
              <Button DockPanel.Dock="Bottom" Margin="0,8,0,0" Content="Add all shown"
                      Command="{Binding AddAllFilteredToKitCommand}"
                      IsEnabled="{Binding CanAddStarterItem}" />

              <Border Classes="list">
                <ListBox ItemsSource="{Binding FilteredCatalog}"
                         SelectedItem="{Binding SelectedCatalogItem, Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ItemTemplate">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Name}" FontSize="13" />
                          <TextBlock Text="{Binding Category}" Classes="muted" FontSize="11" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TemplateId}" Classes="muted"
                                   FontFamily="Consolas, monospace" VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </DockPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Margin="12,0">
              <Button Content="Add →" Command="{Binding AddSelectedItemToKitCommand}"
                      IsEnabled="{Binding CanAddStarterItem}" />
              <Button Content="← Remove" Command="{Binding RemoveSelectedItemFromKitCommand}"
                      IsEnabled="{Binding CanRemoveStarterItem}" />
            </StackPanel>

            <DockPanel Grid.Column="2">
              <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
                <TextBlock Classes="label" Text="Granted after the tutorial" />
                <TextBlock Classes="muted" Text="{Binding StarterKitSummary}" />
              </StackPanel>

              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Reset to wand + deck" Command="{Binding ResetStarterKitCommand}" />
                <Button Classes="accent" Content="Save starter kit" Command="{Binding SaveStarterKitCommand}" />
              </StackPanel>

              <Border Classes="list">
                <ListBox ItemsSource="{Binding StarterKit}"
                         SelectedItem="{Binding SelectedStarterItem, Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ItemTemplate">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Name}" FontSize="13" />
                          <TextBlock Text="{Binding Category}" Classes="muted" FontSize="11" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TemplateId}" Classes="muted"
                                   FontFamily="Consolas, monospace" VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </DockPanel>

          </Grid>

          <!-- The item names come from Imlight's own list for now, because the game's data cannot be
               decoded yet. One short line here; About explains what that means. -->
          <Border Classes="card" Padding="14" BorderBrush="{DynamicResource WarningBrush}">
            <StackPanel Spacing="6">
              <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"
                         Text="Names are limited for now" IsVisible="{Binding ItemsAreStubbed}" />
              <TextBlock Classes="muted" Text="{Binding ItemsNotice}" />
              <TextBlock Classes="value" Text="{Binding RootWadProbeText}" />
              <TextBlock Classes="muted" Text="{Binding RootWadManifestText}" />
            </StackPanel>
          </Border>

        </StackPanel>
      </Border>

      <!-- ==================================================== network -->
      <Border Classes="card" IsVisible="{Binding IsImlightSettings}">
        <StackPanel Spacing="12">
          <TextBlock Classes="cardTitle" Text="Network" />

          <Grid ColumnDefinitions="*,16,*">
            <StackPanel>
              <TextBlock Classes="label" Text="Server address given to the client (GameServerIP)" />
              <TextBox Text="{Binding GameServerIp, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="Login port (LoginServerPort)" />
              <TextBox Text="{Binding LoginServerPort, Mode=TwoWay}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,16,*">
            <StackPanel>
              <TextBlock Classes="label" Text="First realm's port (GameServerPort)" />
              <TextBox Text="{Binding GameServerPort, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="How many realms (GameServerCount)" />
              <TextBox Text="{Binding GameServerCount, Mode=TwoWay}" />
            </StackPanel>
          </Grid>

          <StackPanel>
            <TextBlock Classes="label" Text="Realm names, comma-separated (RealmNames)" />
            <TextBox Text="{Binding RealmNames, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Client launch arguments" />
            <TextBlock Classes="value" Text="{Binding ClientLaunchArguments}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ==================================================== world data -->
      <Border Classes="card" IsVisible="{Binding IsImlightSettings}">
        <StackPanel Spacing="12">
          <TextBlock Classes="cardTitle" Text="World data and logging" />

          <CheckBox Content="Fetch the latest world data on every start (SpiralDBAutoFetch)"
                    IsChecked="{Binding SpiralDbAutoFetch, Mode=TwoWay}" />

          <Grid ColumnDefinitions="*,16,*">
            <StackPanel>
              <TextBlock Classes="label" Text="Server log level (LogLevel)" />
              <ComboBox ItemsSource="{Binding LogLevels}"
                        SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="Client revision this server accepts (GameRevision)" />
              <TextBox Text="{Binding GameRevision, Mode=TwoWay}"
                       IsEnabled="{Binding CanEditGameRevision}" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="{Binding PatchServerRevisionStatus}"
                         IsVisible="{Binding HasPatchServerRevisionStatus}" />
            </StackPanel>
          </Grid>

          <CheckBox Content="Refuse clients whose revision does not match (EnforceRevision)"
                    IsChecked="{Binding EnforceRevision, Mode=TwoWay}" />

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Database port (EmbeddedDatabasePort)" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding EmbeddedDatabasePort, Mode=TwoWay}" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="Find a free port"
                      Command="{Binding FindFreeEmbeddedDatabasePortCommand}" />
            </Grid>
            <TextBlock Classes="muted note"
                       Text="The server's own database listens here. Imlight will not start when 8080 is already taken by something else, so the launcher moves it to a free port for you." />
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- ==================================================== the launcher itself -->
      <Border Classes="card" IsVisible="{Binding IsLauncherSettings}">
        <StackPanel Spacing="10">
          <TextBlock Classes="cardTitle" Text="ViewLight Settings" />

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Theme" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}"
                      HorizontalAlignment="Left" MinWidth="200" />
            <TextBlock Classes="muted note"
                       Text="System follows your desktop's light or dark setting. The change applies straight away, with no restart." />
          </StackPanel>

          <!-- The page the launcher opens on. A setting rather than a memory, so leaving the launcher on
               any given page does not change where the next start begins. -->
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Default page" />
            <ComboBox ItemsSource="{Binding LandingPages}"
                      SelectedItem="{Binding DefaultLandingPage, Mode=TwoWay}"
                      HorizontalAlignment="Left" MinWidth="200" />
            <TextBlock Classes="muted note"
                       Text="Which page ViewLight opens on. Home is the default: starting the launcher should land you ready to play, not on whatever page you last looked at." />
          </StackPanel>

          <CheckBox Content="Ask before closing while the server is running"
                    IsChecked="{Binding ConfirmCloseWhenServerRunning, Mode=TwoWay}" />

          <TextBlock Classes="muted note"
                     Text="Closing ViewLight stops everything it started - the server and the patch server - so it asks first. That is true even if the launcher is killed outright, so neither can ever be left holding its ports." />

          <!-- Milestones are the rungs of two long ladders - every five levels of every school, every ten
               duels - so somebody levelling or farming earns a run of them in one session. -->
          <CheckBox Content="Announce milestone achievements (the level and battle ladders)"
                    IsChecked="{Binding ShowMilestoneToasts, Mode=TwoWay}" />

          <TextBlock Classes="muted note"
                     Text="Turning these off stops the notification only: the badge is still earned, still worth its points, and still on the profile." />

          <!-- The notes are comments on the screen rather than part of it, so they are off until somebody
               asks to read them - the same switch that shows this one. -->
          <CheckBox Content="Verbose mode — show what everything is for"
                    IsChecked="{Binding VerboseMode, Mode=TwoWay}" />

          <TextBlock Classes="muted note" TextWrapping="Wrap"
                     Text="Shows the explanation under each control: what a setting changes, which file it is written to, and why it is there. Off by default, because a launcher is used rather than read." />

          <!-- Portable mode decides where everything lives, so it is a launcher setting - and one that
               takes a restart, because the paths in use were settled when this run began. -->
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Portable mode" />

            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
              <TextBlock Classes="label" Text="This run" />
              <TextBlock Grid.Column="1" Classes="value" Text="{Binding PortableRunText}" />
              <TextBlock Grid.Row="1" Classes="label" Text="Lives in" />
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding LauncherRoot}" />
            </Grid>

            <Button HorizontalAlignment="Left" Content="{Binding PortableToggleLabel}"
                    Command="{Binding TogglePortableModeCommand}" />

            <TextBlock Classes="warning" Text="{Binding PortableRestartNote}"
                       IsVisible="{Binding PortableNeedsRestart}" />

            <TextBlock Classes="muted note"
                       Text="Portable mode keeps ViewLight's settings, the server and the game in the folder it is run from, so the whole thing can be moved to another drive and still work. A Steam copy of the game still needs Steam installed to launch, because that is the game's own dependency rather than ViewLight's; a standalone install copied in has no such requirement." />
          </StackPanel>
        </StackPanel>
      </Border>          <!-- ==================================================== the cloud backup
           A copy of the two databases that cannot be downloaded again - the launcher's own notes and the
           server's RavenDB - kept in the user's own Google Drive, in the app's private folder. Off until it
           is turned on here; nothing is copied while a database is held open, which is why a sync stops the
           launcher's databases first, why the server itself has to be down, and why the pages that write to
           them are turned off for the moment it takes. -->
      <Border Classes="card" IsVisible="{Binding IsDataSettings}">
        <StackPanel Spacing="12">
          <TextBlock Classes="cardTitle" Text="Cloud backup" />

          <TextBlock Classes="muted note" TextWrapping="Wrap"
                     Text="A safety net for the data that cannot be downloaded again: the accounts, the wizards, the profiles, the playtime and the badges. It is kept in your own Google Drive, in a folder belonging to ViewLight that you cannot see in Drive and that cannot reach any other file. The game's files, the client, the server binaries and the cached downloads are not backed up - those can be fetched again." />

          <CheckBox Content="Keep a backup in my cloud drive"
                    IsChecked="{Binding BackUpToCloud, Mode=TwoWay}" />

          <!-- The one question about signing in, and it is whose Google app does it: ViewLight's own, which
               needs nothing set up but is not offered until this build carries a client, or one the user
               registered themselves. Everything below follows from the answer. -->
          <StackPanel Spacing="6" IsVisible="{Binding BackUpToCloud}">
            <TextBlock Classes="label" Text="Sign in with" />

            <RadioButton GroupName="CloudSignIn"
                         Content="My own Google app (bring your own)"
                         IsChecked="{Binding UsesOwnGoogleClient, Mode=TwoWay}" />

            <RadioButton GroupName="CloudSignIn"
                         Content="ViewLight's built-in Google sign-in"
                         IsEnabled="{Binding HasBuiltInGoogleClient}"
                         IsChecked="{Binding CloudBackupUsesBuiltInClient, Mode=TwoWay}" />

            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{Binding BuiltInClientNotice}" />
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding UsesOwnGoogleClient}">
            <TextBlock Classes="label" Text="Google client id" />
            <TextBox Text="{Binding CloudBackupClientId, Mode=TwoWay}"
                     Watermark="…apps.googleusercontent.com" />
            <TextBlock Classes="label" Text="Client secret" />
            <TextBox Text="{Binding CloudBackupClientSecret, Mode=TwoWay}" PasswordChar="•" />
            <TextBlock Classes="muted note" TextWrapping="Wrap"
                       Text="Register an OAuth client once (the readme says how) and paste its id here. Which type it is decides whether the secret is needed: a Desktop-app client is bound to the redirect by a PKCE verifier and needs no secret, while a Web-application client has to send its own secret on every call and Google refuses it without one - so paste the secret too if the client is a Web application. Spaces and line breaks around either value are stripped before they are used, so a copy straight out of the Cloud console is fine. Both are kept in ViewLight's own settings on this machine, never sent anywhere but Google." />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding BackUpToCloud}">
            <Button Classes="accent" Content="Sign in to Google Drive"
                    Command="{Binding SignInToCloudCommand}"
                    IsEnabled="{Binding CanSignInToCloud}" />

            <!-- The way back from a sign-in that is being waited on. Closing the browser window the sign-in
                 opened leaves nothing for the launcher to receive, and there is nothing in the browser that can
                 tell it so - so the wait is stopped from here rather than sat out. -->
            <Button Content="Cancel sign-in" Command="{Binding CancelCloudSignInCommand}"
                    IsVisible="{Binding CanCancelCloudSignIn}" />
            <Button Content="Sign out" Command="{Binding SignOutOfCloudCommand}"
                    IsVisible="{Binding IsCloudBackupSignedIn}" />
            <Button Content="Back up now" Command="{Binding BackUpNowCommand}"
                    IsEnabled="{Binding IsCloudBackupSignedIn}" />
            <Button Content="Restore from the cloud" Command="{Binding RestoreFromCloudCommand}"
                    IsEnabled="{Binding IsCloudBackupSignedIn}" />
          </StackPanel>

          <TextBlock Classes="muted note" TextWrapping="Wrap"
                     Text="Backing up or restoring stops the launcher's databases for a moment - RavenDB locks its data directory, so nothing can be copied while anything has it open - and starts them again afterwards. Settings and profile changes are paused while that lasts, and a sync never runs while the server is up. It also runs by itself three times: when ViewLight starts, just before the server is started, and when the server stops. The ordinary one finds both sides already agree, and says nothing." />

          <TextBlock Classes="status" Text="{Binding CloudBackupStatus}"
                     IsVisible="{Binding HasCloudBackupStatus}" />
        </StackPanel>
      </Border>

      <!-- ==================================================== starting over
           The one irreversible thing in the launcher, so it is described by what it deletes and then asked
           for twice - see Views/WipeDialog. It lives on the Data page, next to the backup, because the two
           are the same subject: what is kept, and what is thrown away. -->
      <Border Classes="card" IsVisible="{Binding IsDataSettings}" Padding="0">
        <StackPanel Spacing="12">
          <TextBlock Classes="cardTitle" Text="Start over completely" />

          <TextBlock Classes="muted note" TextWrapping="Wrap"
                     Text="Deletes both databases and lets ViewLight make itself a new one, so the launcher and your server can begin again from nothing. This cannot be undone, and the only way back is a backup you made yourself." />

          <TextBlock Classes="muted note" TextWrapping="Wrap"
                     Text="It exists because a launcher that has been backed up has no other way out: the copy in the cloud is older than anything a wiped database holds, so a sync would put the old data straight back. Wiping the cloud copy as well - which the confirmation offers - is what makes a genuinely fresh start possible." />

          <Border Classes="list">
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="What would be deleted" />
              <ItemsControl ItemsSource="{Binding ResetTargetNames}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7" Margin="0,2">
                      <TextBlock Text="•" Foreground="{DynamicResource ErrorBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                     Text="{Binding ResetKeepsText}" />

          <TextBlock Classes="warning" TextWrapping="Wrap"
                     Text="{Binding ResetBlockedText}" IsVisible="{Binding IsResetBlocked}" />

          <Button Classes="danger" HorizontalAlignment="Left" Content="Wipe everything…"
                  Command="{Binding StartResetCommand}" IsEnabled="{Binding CanResetNow}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
