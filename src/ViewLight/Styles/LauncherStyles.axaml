<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The palette lives in App.axaml as light and dark theme dictionaries, so every brush here is a
       DynamicResource: that is what lets the theme change while the window is open. -->

  <!-- ============================================================ text -->

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style Selector="TextBlock.status">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="TextBlock.value">
    <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ============================================================ the explanations

       A note is the sentence under a control that says what the control is for. It is a comment on the
       screen rather than part of it, so it is hidden unless verbose mode is on - the window carries a
       "verbose" class for exactly that - and a hidden note takes up no room, so the card it belongs to
       closes up around it rather than leaving a gap. -->
  <Style Selector="TextBlock.note">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="Window.verbose TextBlock.note">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- ============================================================ cards -->

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <!-- A card that floats in the corner rather than sitting in a page: tighter than a page card, and
       shadowed so it is read against the sidebar or a page behind it. -->
  <Style Selector="Border.notification">
    <Setter Property="Padding" Value="12" />
    <Setter Property="BoxShadow" Value="0 4 18 0 #40000000" />
  </Style>

  <!-- The notification tray's opener: a small card in the corner rather than a row of the list it opens,
       because it has to be readable and clickable while the list behind it is folded away. -->
  <Style Selector="Button.tray">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="11,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.tray:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
  </Style>

  <!-- A sunken list container used inside a card. -->
  <Style Selector="Border.list">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <!-- One row of the profile's history: a line between entries rather than a box each, so the list reads
       as a sequence of things that happened rather than as a stack of cards. -->
  <Style Selector="Border.historyRow">
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,0,0,8" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundAltBrush}" />
  </Style>

  <!-- A translucent panel. -->
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{DynamicResource GlassBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.dot">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Border.dot.working">
    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Border.dot.ready">
    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="Border.dot.faulted">
    <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <!-- ============================================================ the pulse

       The launcher's only animation, and deliberately soft: a slow fade that says work is being done
       without asking to be watched. It sits on the indicator of a step that is under way - the dot
       beside a row, or the circle beside a headline - and it is the whole of the "something is
       happening" language, alongside the indeterminate bar under a status that is working. -->
  <Style Selector="Border.dot.pulsing">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Ellipse.pulsing">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ============================================================ the achievement toast

       The one thing in the launcher that appears without being asked for, so it arrives rather than
       simply being there: it slides up from the corner and fades in as a badge is earned, and leaves the
       same way. The motion is a transition on a class rather than an animation on a timer, so the card
       follows the state the view model is in and cannot get stuck on screen.

       Hidden by opacity rather than by collapsing, because a card that is removed cannot animate out -
       the last toast would vanish instead of sliding away. -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource ToastBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ToastAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="MinWidth" Value="300" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />

    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translateY(28px)" />
    <Setter Property="IsHitTestVisible" Value="False" />

    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.toast.shown">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translateY(0)" />
  </Style>

  <!-- The toast's own text, in its own brushes rather than the shared ones.

       Everything else in the launcher is read against a card the launcher drew, so a muted grey is muted
       against something known. The toast sits on the desktop, the taskbar or a full-screen game, and the
       only thing that can be guaranteed about what is behind it is that it is unknown - so its panel is
       opaque and its text is brightened until it is readable over it. -->
  <Style Selector="TextBlock.toastLabel">
    <Setter Property="Foreground" Value="{DynamicResource ToastAccentBrush}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.toastTitle">
    <Setter Property="Foreground" Value="{DynamicResource ToastTitleBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.toastDetail">
    <Setter Property="Foreground" Value="{DynamicResource ToastDetailBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.toastPoints">
    <Setter Property="Foreground" Value="{DynamicResource ToastAccentBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- A group heading that opens and closes what is under it. Flat on purpose: it is a heading rather than
       a button, and it should read as part of the list instead of competing with the badges beneath it. -->
  <Style Selector="Button.group">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.group /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button.group:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ============================================================ the profile card in the corner

       The account the game is signed in as: closed, a picture and a name; clicked, the banner, the name
       and the score. Both sizes are the same element, and the transition on the size is what makes
       opening and folding back a movement rather than a swap - the same trick the toast uses, a
       transition on a class rather than an animation on a timer, so the card follows the state the view
       model is in and cannot get stuck open or shut. -->
  <Style Selector="Border.profileCard">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Width" Value="236" />
    <Setter Property="Height" Value="52" />
    <Setter Property="BoxShadow" Value="0 10 26 0 #66000000" />

    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.28" Easing="CubicEaseOut" />
        <DoubleTransition Property="Height" Duration="0:0:0.28" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.profileCard.open">
    <Setter Property="Width" Value="340" />
    <Setter Property="Height" Value="232" />
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.chip /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
  </Style>

  <!-- The open card is a picture with words on it, so hovering it lightens rather than fills: a hover
       colour of its own would hide the banner the card was opened to show. -->
  <Style Selector="Button.chip.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1FFFFFFF" />
  </Style>

  <!-- ============================================================ nav -->

  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundAltBrush}" />
  </Style>

  <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
  </Style>

  <Style Selector="Button.nav.selected">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- A page's own headings, in a well under it: indented, smaller, and named after the page they hang
       off, so the second row reads as part of the page that is open rather than as four more pages beside
       it. -->
  <Style Selector="Border.subnav">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundAltBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="Button.subnav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.subnav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.subnav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
  </Style>

  <Style Selector="Button.subnav.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
  </Style>

  <Style Selector="Button.subnav.selected">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The page the well belongs to, printed at its left edge: "Server  ImLight | Aurorium". -->
  <Style Selector="TextBlock.subnavCaption">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="6,0,8,0" />
  </Style>

  <!-- ============================================================ buttons -->

  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="#1A0E0E" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- A part of a picture that is a control only while the profile is being dressed: the picture is still
       the picture, with a dashed edge and a scrim over it saying it can be clicked. It covers the banner
       rather than sitting beside it, because the thing being changed is the thing that is clicked. -->
  <Style Selector="Button.hotspot">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.hotspot /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33000000" />
    <Setter Property="BorderBrush" Value="#99FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.hotspot:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#66000000" />
    <Setter Property="BorderBrush" Value="#FFFFFFFF" />
  </Style>

  <!-- The profile picture is a circle, so its hotspot is one too rather than a rounded square laid over it. -->
  <Style Selector="Button.hotspot.round">
    <Setter Property="CornerRadius" Value="38" />
  </Style>

  <Style Selector="Button.hotspot.round /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="38" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ============================================================ the sign-in screen

       Shown when nobody is signed in, and covering everything, because every page behind it belongs to
       nobody. It is faded and hit-tested by its class rather than shown and hidden, so it arrives the way the
       corner card opens - a transition on a class, so the screen follows the state the view model is in and
       cannot get stuck half-shown. -->
  <Style Selector="Border.signIn">
    <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="RenderTransform" Value="scale(1.015)" />

    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.signIn.shown">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>

  <!-- The row of accounts slides in rather than being drawn: it is the one thing on the screen, and a row that
       arrives says there are more of them off the edge.

       A transition on the shown class rather than a keyframe animation, for two reasons: the value is the
       state the view model is in, so it cannot get stuck half-way, and RenderTransform has no animator
       registered by default - a keyframe animation on it throws when the style is attached. -->
  <Style Selector="ScrollViewer.accountStrip">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translateX(48px)" />

    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.45" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.signIn.shown ScrollViewer.accountStrip">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translateX(0px)" />
  </Style>

  <Style Selector="Button.accountCard">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="8" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.accountCard /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button.accountCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- The tile is a picture with words on it, so a hover lifts it rather than filling it: a hover colour of its
       own would hide the banner the tile was drawn to show. -->
  <Style Selector="Border.accountTile">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BoxShadow" Value="0 10 26 0 #66000000" />
    <Setter Property="RenderTransform" Value="translateY(0px)" />

    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.accountCard:pointerover Border.accountTile">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="RenderTransform" Value="translateY(-6px) scale(1.01)" />
  </Style>

  <!-- An arrow is a movement rather than a button in a form, so it is a quiet block beside the row. -->
  <Style Selector="Button.signInArrow">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="74" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- ============================================================ inputs -->

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ============================================================ the big play button -->

  <!-- Combine with .accent for the colours: Classes="accent play" -->
  <Style Selector="Button.play">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="48,16" />
    <Setter Property="MinWidth" Value="260" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- ============================================================ the banner -->

  <Style Selector="Border.hero">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BoxShadow" Value="0 18 44 0 #99000000" />
  </Style>

  <Style Selector="Border.heroScrim">
    <Setter Property="Background" Value="{DynamicResource HeroScrimBrush}" />
  </Style>

  <Style Selector="TextBlock.heroHint">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#DDE4F2" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- The wordmark stands in for the game's own logo until it has been fetched, so the banner reads
       as Wizard101 from the first frame - on the first run, offline, before any art exists. -->
  <Style Selector="TextBlock.heroWordmark">
    <Setter Property="FontSize" Value="54" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="#F2C14E" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ============================================================ the play button -->

  <Style Selector="Button.heroPlay /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayGradientBrush}" />
    <Setter Property="BorderBrush" Value="#40FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="Button.heroPlay:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayGradientHoverBrush}" />
  </Style>

  <Style Selector="Button.heroPlay:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayGradientPressedBrush}" />
  </Style>

  <Style Selector="Button.heroPlay:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayDisabledBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.heroPlay">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="58,16" />
    <Setter Property="MinWidth" Value="300" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- ============================================================ the same button, split

       The hero button is a SplitButton so that pressing its left half still plays while its caret
       opens every other way to play. Avalonia draws each half from its own split-button theme, which
       paints a solid colour on hover and press - so the gradient has to be put back on the inner
       buttons, states included, or the hero button would change colour under the mouse. -->
  <Style Selector="SplitButton.heroPlay">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="58,16" />
    <Setter Property="MinWidth" Value="300" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource PlayGradientBrush}" />
    <Setter Property="BorderBrush" Value="#40FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="SplitButton.heroPlay /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayGradientBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="SplitButton.heroPlay /template/ Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayGradientHoverBrush}" />
  </Style>

  <Style Selector="SplitButton.heroPlay /template/ Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayGradientPressedBrush}" />
  </Style>

  <!-- Both halves are tagged while the menu is open, so the caret stays lit until it closes. -->
  <Style Selector="SplitButton.heroPlay /template/ Button[Tag=flyout-open] /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayGradientPressedBrush}" />
  </Style>

  <Style Selector="SplitButton.heroPlay /template/ Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayDisabledBrush}" />
  </Style>

  <!-- ============================================================ hero -->

  <Style Selector="TextBlock.heroTitle">
    <Setter Property="FontSize" Value="42" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- ============================================================ the log

       The log is a terminal: runs of lines are drawn as monospace text that is not wrapped, so a reading or
       a picture a process printed keeps the shape it was written in and a drag across it copies the whole
       run. The colour comes from the block's severity, set on the control by the view, because a converter
       cannot follow the theme the way a DynamicResource can. -->
  <Style Selector="SelectableTextBlock.terminal">
    <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- The line a folded run of the same log line is drawn as. It is a button, so it has to look like the
       text around it: no chrome, a pointer cursor, and a highlight on hover to say it can be pressed. -->
  <Style Selector="Button.logFold">
    <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.logFold /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button.logFold:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
  </Style>

</Styles>
